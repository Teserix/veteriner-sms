<%- include('partials/header') %>
<div class="row between">
  <h1>Hasta Sahipleri</h1>
  <a class="btn" href="/sahipler/yeni">+ Yeni hasta sahibi</a>
</div>
<div class="card">
  <form method="get" action="/sahipler" class="search">
    <input type="search" name="q" inputmode="search" enterkeyhint="search" autocomplete="off" aria-label="Hasta sahibi ara" placeholder="Ad veya telefon ara…" value="<%= q %>">
    <button class="btn secondary" type="submit">Ara</button>
    <% if (q) { %><a class="btn secondary" href="/sahipler">Temizle</a><% } %>
  </form>
</div>
<div class="card">
  <% if (!list.length) { %><div class="empty">Kayıt bulunamadı.</div><% } else { %>
  <table class="cards">
    <thead><tr><th>Ad</th><th>Telefon</th><th>Hayvan</th><th>SMS</th><th><span class="visually-hidden">İşlemler</span></th></tr></thead>
    <tbody>
    <% for (const o of list) { %>
    <tr>
      <td data-label="Ad"><a href="/sahipler/<%= o.id %>"><%= o.name %></a></td>
      <td class="mono" data-label="Telefon"><a href="tel:<%= o.phone %>"><%= formatPhone(o.phone) %></a></td>
      <td data-label="Hayvan"><%= o.pet_count %></td>
      <td data-label="SMS"><% if (o.sms_opt_in) { %><span class="badge ok">Açık</span><% } else { %><span class="badge cancelled">Kapalı</span><% } %></td>
      <td class="actions"><a class="btn sm secondary" href="/sahipler/<%= o.id %>">Detay</a></td>
    </tr>
    <% } %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('partials/footer') %>
