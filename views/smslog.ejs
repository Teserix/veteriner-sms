<%- include('partials/header') %>
<div class="page-head">
  <div>
    <h1>SMS Geçmişi</h1>
    <p class="sub">Son <%= list.length %> gönderim · otomatik, elle ve test mesajları</p>
  </div>
</div>
<div class="card flush">
  <% if (!list.length) { %>
    <div class="empty-state"><span class="es-icon"><%- icon('message') %></span><span class="es-title">Henüz SMS gönderilmemiş.</span><span class="es-text">Hatırlatmalar gönderildikçe her mesaj, alıcısı ve sağlayıcı yanıtıyla burada listelenir.</span></div>
  <% } else { %>
  <table class="cards">
    <thead><tr><th scope="col">Alıcı</th><th scope="col">Zaman</th><th scope="col">Mesaj</th><th scope="col">Sağlayıcı</th><th scope="col">Durum</th></tr></thead>
    <tbody>
    <% for (const s of list) { %>
    <tr>
      <td data-label="Alıcı"><% if (s.owner_exists) { %><a class="cell-title" href="/sahipler/<%= s.owner_id %>"><%= s.owner_name_display %></a><% } else { %><span class="cell-title"><%= s.owner_name_display || '—' %></span><% if (s.owner_name_display) { %> <span class="small muted">(silinmiş)</span><% } %><% } %><span class="cell-sub tnum"><%= formatPhone(s.phone) %><% if (s.pet_name_display) { %> · <%= s.pet_name_display %><% } %></span></td>
      <td class="small tnum" data-label="Zaman"><%= formatDateTime(s.created_at) %><span class="cell-sub"><%= s.sent_by === 'zamanlayici' ? 'otomatik' : s.sent_by %><%= s.kind === 'test' ? ' · test' : '' %></span></td>
      <td class="small pre" data-label="Mesaj"><%= s.message %><% if (s.legal_basis) { %><span class="cell-sub">dayanak: <%= s.legal_basis === 'm6_1' ? 'm.6/1 bakım bilgilendirmesi' : s.legal_basis %> · iys=<%= s.iys_flag %></span><% } %><% if (s.anonymized_at) { %><span class="cell-sub">anonimleştirildi <%= formatDateTime(s.anonymized_at) %></span><% } %></td>
      <td class="small" data-label="Sağlayıcı"><%= s.provider %><% if (s.provider_ref) { %><span class="cell-sub mono"><%= s.provider_ref %></span><% } %></td>
      <td data-label="Durum"><span class="badge <%= s.status === 'sent' ? 'ok' : 'failed' %>"><%= s.status === 'sent' ? 'Gönderildi' : 'Hata' %></span><% if (s.error) { %><span class="cell-sub"><%= s.error %></span><% } %></td>
    </tr>
    <% } %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('partials/footer') %>
