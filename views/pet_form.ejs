<%- include('partials/header') %>
<h1><%= pet ? 'Hayvanı düzenle' : 'Yeni hayvan' %> <span class="muted small">· <%= owner.name %></span></h1>
<div class="card">
  <% if (error) { %><div class="flash err"><%= error %></div><% } %>
  <form method="post" action="<%= pet ? '/hayvanlar/' + pet.id + '/duzenle' : '/sahipler/' + owner.id + '/hayvan/yeni' %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="form-grid">
      <div><label for="name">Ad *</label><input id="name" type="text" name="name" required maxlength="80" value="<%= form.name || '' %>"></div>
      <div><label for="species">Tür</label>
        <select id="species" name="species">
          <% for (const s of SPECIES) { %><option value="<%= s %>" <%= form.species === s ? 'selected' : '' %>><%= s %></option><% } %>
        </select></div>
      <div><label for="breed">Irk</label><input id="breed" type="text" name="breed" maxlength="80" value="<%= form.breed || '' %>"></div>
      <div><label for="sex">Cinsiyet</label>
        <select id="sex" name="sex">
          <option value="" <%= !form.sex ? 'selected' : '' %>>Belirtilmedi</option>
          <option value="Dişi" <%= form.sex === 'Dişi' ? 'selected' : '' %>>Dişi</option>
          <option value="Erkek" <%= form.sex === 'Erkek' ? 'selected' : '' %>>Erkek</option>
        </select></div>
      <div><label for="birth_date">Doğum tarihi</label><input id="birth_date" type="date" name="birth_date" value="<%= form.birth_date || '' %>"></div>
    </div>
    <label for="notes">Not</label>
    <textarea id="notes" name="notes" maxlength="1000"><%= form.notes || '' %></textarea>
    <div class="form-actions">
      <button class="btn" type="submit">Kaydet</button>
      <a class="btn secondary" href="/sahipler/<%= owner.id %>">Vazgeç</a>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
