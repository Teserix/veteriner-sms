<%- include('partials/header') %>
<div class="page-head"><div><h1>Parola değiştir</h1><p class="sub"><%= user.name %> · <%= user.email %></p></div></div>
<div class="card form-card narrow">
  <% if (user.mustChangePassword) { %><div class="alert warn"><%- icon('key') %><div>Geçici parolayla giriş yaptınız. Devam etmek için yeni bir parola belirleyin.</div></div><% } %>
  <% if (error) { %><div class="flash err" role="alert"><%- icon('alert') %><span><%= error %></span></div><% } %>
  <form method="post" action="/sifre">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="current">Mevcut parola</label>
    <input id="current" type="password" name="current" required autocomplete="current-password">
    <label for="password">Yeni parola</label>
    <input id="password" type="password" name="password" required autocomplete="new-password" aria-describedby="pw-help">
    <div class="help" id="pw-help">En az 8 karakter; harf ve rakam içermeli.</div>
    <label for="password2">Yeni parola (tekrar)</label>
    <input id="password2" type="password" name="password2" required autocomplete="new-password" enterkeyhint="done">
    <div class="form-actions"><button class="btn" type="submit"><%- icon('check') %>Kaydet</button></div>
  </form>
</div>
<%- include('partials/footer') %>
