<%- include('partials/header') %>
<h1>Parola değiştir</h1>
<div class="card maxw480">
  <p class="small muted"><%= user.name %> · <%= user.email %></p>
  <% if (user.mustChangePassword) { %><div class="warnbox">Geçici parolayla giriş yaptınız. Devam etmek için yeni bir parola belirleyin.</div><% } %>
  <% if (error) { %><div class="flash err"><%= error %></div><% } %>
  <form method="post" action="/sifre">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="current">Mevcut parola</label>
    <input id="current" type="password" name="current" required autocomplete="current-password">
    <label for="password">Yeni parola</label>
    <input id="password" type="password" name="password" required autocomplete="new-password">
    <label for="password2">Yeni parola (tekrar)</label>
    <input id="password2" type="password" name="password2" required autocomplete="new-password">
    <div class="form-actions"><button class="btn" type="submit">Kaydet</button></div>
  </form>
</div>
<%- include('partials/footer') %>
