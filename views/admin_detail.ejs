<%- include('partials/header') %>
<div class="row between">
  <h1><%= clinic.name %> <% if (!clinic.active) { %><span class="badge cancelled">Pasif</span><% } %></h1>
  <a class="btn secondary" href="/admin">← Klinikler</a>
</div>
<% if (error) { %><div class="flash err"><%= error %></div><% } %>
<% if (tempPassword) { %>
<div class="card tempbox">
  <strong><%= tempFor.name %></strong> (<%= tempFor.email %>) için geçici parola: <code class="mono big"><%= tempPassword %></code>
  <div class="help">Yalnızca şimdi görüntüleniyor. Kullanıcıya iletin; ilk girişte değiştirmesi istenecek.</div>
</div>
<% } %>

<div class="card">
  <h2 class="mt0">Klinik bilgileri</h2>
  <form method="post" action="/admin/klinik/<%= clinic.id %>/duzenle">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="form-grid">
      <div><label for="name">Klinik adı</label><input id="name" type="text" name="name" required maxlength="80" value="<%= clinic.name %>"></div>
      <div><label for="phone">Telefon</label><input id="phone" type="tel" name="phone" maxlength="30" inputmode="tel" autocomplete="off" value="<%= clinic.phone || '' %>"></div>
      <div><label for="sms_daily_cap">Günlük SMS tavanı</label><input id="sms_daily_cap" type="number" name="sms_daily_cap" inputmode="numeric" min="0" max="5000" value="<%= clinic.sms_daily_cap %>"><div class="help">Klinik kendi ayarında bunun üstüne çıkamaz.</div></div>
    </div>
    <p class="small muted mono">Kimlik: <%= clinic.id %> · Dosya: tenants/<%= clinic.id %>.db · Oluşturma: <%= formatDateTime(clinic.created_at) %></p>
    <p class="small muted">Hasta sahibi aydınlatma metni: <a href="/aydinlatma/<%= clinic.public_slug %>" target="_blank" rel="noopener">/aydinlatma/<%= clinic.public_slug %></a></p>
    <div class="form-actions"><button class="btn" type="submit">Kaydet</button></div>
  </form>
</div>

<h2>Sözleşme kabulleri</h2>
<div class="card">
  <% if (!acceptances.length) { %><div class="empty">Klinik yöneticisi henüz sözleşmeyi kabul etmedi; ilk girişte istenecek.</div><% } else { %>
  <table class="cards small">
    <thead><tr><th>Belge</th><th>Sürüm</th><th>Kabul</th><th>Kullanıcı</th><th>IP</th><th>Özet</th></tr></thead>
    <tbody><% for (const a of acceptances) { %>
      <tr><td data-label="Belge"><%= a.slug %></td><td data-label="Sürüm"><%= a.version %></td><td data-label="Kabul"><%= formatDateTime(a.accepted_at) %></td><td data-label="Kullanıcı">#<%= a.user_id %></td><td data-label="IP"><%= a.ip || '' %></td><td data-label="Özet" class="mono"><%= a.doc_sha256.slice(0, 12) %></td></tr>
    <% } %></tbody>
  </table>
  <% } %>
</div>

<h2>Kullanıcılar</h2>
<div class="card">
  <table class="cards">
    <thead><tr><th>Ad</th><th>E-posta</th><th>Rol</th><th>Durum</th><th>Son giriş</th><th><span class="visually-hidden">İşlemler</span></th></tr></thead>
    <tbody>
    <% for (const u of userList) { %>
    <tr>
      <td data-label="Ad"><%= u.name %></td>
      <td data-label="E-posta"><%= u.email %></td>
      <td data-label="Rol"><%= u.role === 'admin' ? 'Yönetici' : 'Personel' %></td>
      <td data-label="Durum"><% if (u.active) { %><span class="badge ok">Aktif</span><% } else { %><span class="badge cancelled">Pasif</span><% } %></td>
      <td class="small" data-label="Son giriş"><%= formatDateTime(u.last_login_at) || '—' %></td>
      <td class="actions">
        <form method="post" action="/admin/klinik/<%= clinic.id %>/sifre-sifirla" data-confirm="Geçici parola üretilsin mi?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="user_id" value="<%= u.id %>"><button class="btn sm secondary" type="submit">Parola sıfırla</button></form>
      </td>
    </tr>
    <% } %>
    </tbody>
  </table>
</div>

<h2>Tehlikeli işlemler</h2>
<div class="card">
  <div class="row between">
    <form method="post" action="/admin/klinik/<%= clinic.id %>/durum"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="active" value="<%= clinic.active ? 0 : 1 %>"><button class="btn secondary" type="submit"><%= clinic.active ? 'Pasifleştir (kullanıcılar giriş yapamaz)' : 'Aktifleştir' %></button></form>
  </div>
  <form method="post" action="/admin/klinik/<%= clinic.id %>/sil" class="row mt10" data-confirm="Klinik silinecek. Veritabanı dosyası data/trash/ altına taşınır. Emin misiniz?">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="text" name="confirm_name" placeholder="Onay için klinik adını yazın" class="maxw260" autocomplete="off">
    <button class="btn danger" type="submit">Kliniği sil</button>
  </form>
</div>
<%- include('partials/footer') %>
