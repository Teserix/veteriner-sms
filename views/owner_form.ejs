<%- include('partials/header') %>
<h1><%= owner ? 'Hasta sahibini düzenle' : 'Yeni hasta sahibi' %></h1>
<div class="card">
  <% if (error) { %><div class="flash err"><%= error %></div><% } %>
  <form method="post" action="<%= owner ? '/sahipler/' + owner.id + '/duzenle' : '/sahipler/yeni' %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="form-grid">
      <div>
        <label for="name">Ad Soyad *</label>
        <input id="name" type="text" name="name" required maxlength="120" value="<%= form.name || '' %>">
      </div>
      <div>
        <label for="phone">Cep telefonu *</label>
        <input id="phone" type="tel" name="phone" required placeholder="05xx xxx xx xx" value="<%= form.phone || '' %>">
        <div class="help">SMS bu numaraya gider. 05xx ile başlayan Türkiye numarası.</div>
      </div>
      <div>
        <label for="email">E-posta</label>
        <input id="email" type="email" name="email" maxlength="120" value="<%= form.email || '' %>">
      </div>
    </div>
    <label for="notes">Not</label>
    <textarea id="notes" name="notes" maxlength="1000"><%= form.notes || '' %></textarea>
    <label class="checkbox"><input type="checkbox" name="sms_opt_in" value="1" <%= form.sms_opt_in === undefined || form.sms_opt_in ? 'checked' : '' %>> SMS hatırlatması gönderilsin</label>
    <div class="form-actions">
      <button class="btn" type="submit">Kaydet</button>
      <a class="btn secondary" href="<%= owner ? '/sahipler/' + owner.id : '/sahipler' %>">Vazgeç</a>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
