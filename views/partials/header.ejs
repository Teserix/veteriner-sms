<%
  const _user = (typeof user !== 'undefined') ? user : null;
  const _path = (typeof currentPath === 'string') ? currentPath : '';
  const _flash = (typeof flash === 'object' && flash) ? flash : { ok: '', err: '' };
  const _csrf = (typeof csrf === 'string') ? csrf : '';
  const _title = (typeof title === 'string') ? title : '';
  const _legalLocked = (typeof legalLocked === 'boolean') ? legalLocked : false;
  const _tourAuto = Boolean(typeof tourAuto !== 'undefined' && tourAuto) && !_legalLocked;
  const _openRequests = (typeof openRequests === 'number') ? openRequests : 0;
  const _v = (typeof assetV === 'string') ? assetV : '';
  const _icon = (typeof icon === 'function') ? icon : () => '';
  const esc = (v) => String(v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const isActive = (p, extra) => _path === p || !!(extra && extra.some((x) => _path.startsWith(x)));
  // tour: karşılama turu kancası (data-tour="..."; public/tour.js bu adları arar)
  const nav = (p, label, ic, extra, count, tour) => {
    const on = isActive(p, extra);
    return `<a href="${esc(p)}" class="nav-link${on ? ' active' : ''}"${on ? ' aria-current="page"' : ''}${tour ? ` data-tour="${esc(tour)}"` : ''}>${_icon(ic)}<span class="nav-label">${esc(label)}</span>${count ? `<span class="nav-count" aria-label="${count} açık">${count}</span>` : ''}</a>`;
  };
  const initials = (n) => String(n || '?').trim().split(/\s+/).filter((w) => !/^(dr|vet|hek)\.?$/i.test(w)).slice(0, 2).map((w) => w[0]).join('').toLocaleUpperCase('tr') || '?';
  const roleLabel = _user ? ({ superadmin: 'Sistem yöneticisi', admin: 'Klinik yöneticisi', staff: 'Personel' }[_user.role] || '') : '';
  const isClinic = !!(_user && _user.clinicId);
  const home = _user && _user.role === 'superadmin' ? '/admin' : '/';
%>
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0f766e">
  <meta name="color-scheme" content="light">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Vet SMS">
  <% if (_user) { %><meta name="csrf-token" content="<%= _csrf %>"><% } %>
  <link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png">
  <link rel="icon" href="/static/icons/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/static/icons/icon-192.png" sizes="192x192" type="image/png">
  <title><%= _title ? _title + ' · ' : '' %>Veteriner SMS</title>
  <link rel="stylesheet" href="/static/style.css<%= _v ? '?v=' + _v : '' %>">
</head>
<body class="<%= _user ? 'has-shell' : 'no-shell' %><%= isClinic ? ' has-tabbar' : '' %>"<% if (_tourAuto) { %> data-tour-auto="1"<% } %>>
<a class="skip-link" href="#main">İçeriğe geç</a>
<% if (_user) { %>
<div class="shell">
  <aside class="sidebar" id="site-nav" aria-label="Ana menü">
    <div class="sidebar-head">
      <a class="brand" href="<%= home %>"><img class="brand-mark" src="/static/icons/favicon.svg" alt="" width="32" height="32"><span class="brand-text">Veteriner SMS</span></a>
      <button class="icon-btn nav-close" type="button" data-nav-close aria-label="Menüyü kapat"><%- _icon('x') %></button>
    </div>
    <% if (_user.clinicName) { %><div class="clinic-chip" title="<%= _user.clinicName %>"><%- _icon('building') %><span><%= _user.clinicName %></span></div><% } %>
    <nav class="nav">
      <% if (isClinic) { %>
        <a class="btn block nav-cta" href="/hizli-kayit" data-tour="hizli-kayit"><%- _icon('plus') %>Hızlı kayıt</a>
        <div class="nav-group">
          <%- nav('/', 'Özet', 'home') %>
          <%- nav('/hatirlatmalar', 'Hatırlatmalar', 'bell', ['/hatirlatmalar'], 0, 'hatirlatmalar') %>
          <%- nav('/sahipler', 'Hasta Sahipleri', 'users', ['/sahipler', '/hayvanlar'], 0, 'sahipler') %>
          <%- nav('/sms', 'SMS Geçmişi', 'message', ['/sms'], 0, 'sms') %>
        </div>
        <div class="nav-group">
          <div class="nav-heading">Uyum</div>
          <%- nav('/basvurular', 'KVKK başvuruları', 'shield', ['/basvurular'], _openRequests) %>
        </div>
        <% if (_user.role === 'admin') { %>
        <div class="nav-group">
          <div class="nav-heading">Yönetim</div>
          <%- nav('/iceaktar', 'İçe aktar', 'upload', ['/iceaktar']) %>
          <%- nav('/kullanicilar', 'Kullanıcılar', 'user-check', ['/kullanicilar']) %>
          <%- nav('/ayarlar', 'Ayarlar', 'settings', ['/ayarlar'], 0, 'ayarlar') %>
        </div>
        <% } %>
      <% } else if (_user.role === 'superadmin') { %>
        <div class="nav-group">
          <%- nav('/admin', 'Klinikler', 'building', ['/admin/klinik']) %>
          <%- nav('/admin/denetim', 'Denetim', 'history') %>
          <%- nav('/admin/ihlaller', 'Veri ihlalleri', 'alert') %>
        </div>
      <% } %>
    </nav>
    <div class="sidebar-foot">
      <div class="me">
        <span class="avatar" aria-hidden="true"><%= initials(_user.name) %></span>
        <span class="me-text"><span class="me-name"><%= _user.name %></span><span class="me-role"><%= roleLabel %></span></span>
      </div>
      <div class="me-actions">
        <% if (isClinic) { %><a href="#" class="nav-link" data-tour-start><%- _icon('info') %><span class="nav-label">Turu yeniden başlat</span></a><% } %>
        <a href="/sifre" class="nav-link<%= _path === '/sifre' ? ' active' : '' %>"<%- _path === '/sifre' ? ' aria-current="page"' : '' %>><%- _icon('key') %><span class="nav-label">Parola</span></a>
        <form method="post" action="/cikis"><input type="hidden" name="_csrf" value="<%= _csrf %>"><button class="nav-link" type="submit"><%- _icon('logout') %><span class="nav-label">Çıkış</span></button></form>
      </div>
    </div>
  </aside>
  <div class="nav-backdrop" data-nav-close></div>
  <div class="shell-main">
    <header class="topbar">
      <button class="icon-btn nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menü"><%- _icon('menu') %></button>
      <a class="brand" href="<%= home %>"><img class="brand-mark" src="/static/icons/favicon.svg" alt="" width="28" height="28"><span class="brand-text"><%= _user.clinicName || 'Veteriner SMS' %></span></a>
      <% if (isClinic) { %><a class="icon-btn" href="/sahipler" aria-label="Hasta sahibi ara"><%- _icon('search') %></a><% } %>
    </header>
<% } else { %>
<div class="public-shell">
  <% if (_path !== '/giris') { %>
  <header class="public-top">
    <a class="brand" href="/"><img class="brand-mark" src="/static/icons/favicon.svg" alt="" width="32" height="32"><span class="brand-text">Veteriner SMS</span></a>
  </header>
  <% } %>
<% } %>
<main id="main" tabindex="-1">
<% if (_legalLocked && isClinic && _path !== '/ayarlar') { %>
  <div class="alert danger" role="alert"><%- _icon('alert') %><div><strong>SMS gönderimi kilitli:</strong> hukuki kimlik bilgileri eksik.<% if (_user.role === 'admin') { %> <a href="/ayarlar#hukuki-kimlik">Ayarlar › Hukuki kimlik</a> bölümünü tamamlayın.<% } else { %> Klinik yöneticisi Ayarlar'dan tamamlamalı.<% } %></div></div>
<% } %>
<% if (_flash.ok) { %><div class="flash ok" role="status"><%- _icon('check-circle') %><span><%= _flash.ok %></span></div><% } %>
<% if (_flash.err) { %><div class="flash err" role="alert"><%- _icon('alert') %><span><%= _flash.err %></span></div><% } %>
