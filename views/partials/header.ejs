<%
  const _user = (typeof user !== 'undefined') ? user : null;
  const _path = (typeof currentPath === 'string') ? currentPath : '';
  const _flash = (typeof flash === 'object' && flash) ? flash : { ok: '', err: '' };
  const _csrf = (typeof csrf === 'string') ? csrf : '';
  const _title = (typeof title === 'string') ? title : '';
  const esc = (v) => String(v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const nav = (p, label, extra) => `<a href="${esc(p)}" class="${(_path === p || (extra && extra.some((x) => _path.startsWith(x)))) ? 'active' : ''}">${esc(label)}</a>`;
%>
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0f766e">
  <meta name="color-scheme" content="light">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Vet SMS">
  <link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png">
  <link rel="icon" href="/static/icons/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/static/icons/icon-192.png" sizes="192x192" type="image/png">
  <title><%= _title ? _title + ' · ' : '' %>Veteriner SMS</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="<%= _user && _user.role === 'superadmin' ? '/admin' : '/' %>">🐾 Veteriner SMS<% if (_user && _user.clinicName) { %> <span class="who">· <%= _user.clinicName %></span><% } %></a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menü">
    <span class="nav-toggle-bar" aria-hidden="true"></span>
    <span class="nav-toggle-bar" aria-hidden="true"></span>
    <span class="nav-toggle-bar" aria-hidden="true"></span>
  </button>
  <nav id="site-nav" class="site-nav">
    <% if (_user && _user.clinicId) { %>
      <%- nav('/', 'Özet') %>
      <%- nav('/hizli-kayit', 'Hızlı kayıt') %>
      <%- nav('/sahipler', 'Hasta Sahipleri', ['/sahipler', '/hayvanlar']) %>
      <%- nav('/hatirlatmalar', 'Hatırlatmalar', ['/hatirlatmalar']) %>
      <%- nav('/sms', 'SMS Geçmişi', ['/sms']) %>
      <% if (_user.role === 'admin') { %>
        <%- nav('/iceaktar', 'İçe aktar', ['/iceaktar']) %>
        <%- nav('/ayarlar', 'Ayarlar', ['/ayarlar']) %>
        <%- nav('/kullanicilar', 'Kullanıcılar', ['/kullanicilar']) %>
      <% } %>
    <% } else if (_user && _user.role === 'superadmin') { %>
      <%- nav('/admin', 'Klinikler', ['/admin/klinik']) %>
      <%- nav('/admin/denetim', 'Denetim') %>
    <% } %>
    <% if (_user) { %>
      <%- nav('/sifre', _user.name) %>
      <form method="post" action="/cikis"><input type="hidden" name="_csrf" value="<%= _csrf %>"><button class="link" type="submit">Çıkış</button></form>
    <% } %>
  </nav>
</header>
<main>
<% if (_flash.ok) { %><div class="flash ok"><%= _flash.ok %></div><% } %>
<% if (_flash.err) { %><div class="flash err"><%= _flash.err %></div><% } %>
