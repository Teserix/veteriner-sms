<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' · ' : '' %>Veteriner SMS</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">🐾 Veteriner SMS<% if (user && user.clinicName) { %> <span class="who">· <%= user.clinicName %></span><% } %></a>
  <nav>
    <% if (user && user.clinicId) { %>
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Özet</a>
      <a href="/sahipler" class="<%= currentPath.startsWith('/sahipler') || currentPath.startsWith('/hayvanlar') ? 'active' : '' %>">Hasta Sahipleri</a>
      <a href="/hatirlatmalar" class="<%= currentPath.startsWith('/hatirlatmalar') ? 'active' : '' %>">Hatırlatmalar</a>
      <a href="/sms" class="<%= currentPath.startsWith('/sms') ? 'active' : '' %>">SMS Geçmişi</a>
      <% if (user.role === 'admin') { %>
        <a href="/ayarlar" class="<%= currentPath.startsWith('/ayarlar') ? 'active' : '' %>">Ayarlar</a>
        <a href="/kullanicilar" class="<%= currentPath.startsWith('/kullanicilar') ? 'active' : '' %>">Kullanıcılar</a>
      <% } %>
    <% } else if (user && user.role === 'superadmin') { %>
      <a href="/admin" class="active">Klinikler</a>
    <% } %>
    <% if (user) { %>
      <a href="/sifre" class="<%= currentPath === '/sifre' ? 'active' : '' %>"><%= user.name %></a>
      <form method="post" action="/cikis"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link" type="submit">Çıkış</button></form>
    <% } %>
  </nav>
</header>
<main>
<% if (flash && flash.ok) { %><div class="flash ok"><%= flash.ok %></div><% } %>
<% if (flash && flash.err) { %><div class="flash err"><%= flash.err %></div><% } %>
