<%- include('partials/header') %>
<div class="row between">
  <h1><%= owner.name %></h1>
  <div class="row">
    <% if (!anonymized) { %><a class="btn secondary" href="/sahipler/<%= owner.id %>/duzenle">Düzenle</a><% } %>
    <% if (user.role === 'admin' && !anonymized) { %>
    <a class="btn sm secondary" href="/sahipler/<%= owner.id %>/veri.json">Veri (JSON)</a>
    <a class="btn sm secondary" href="/sahipler/<%= owner.id %>/veri.csv">Veri (CSV)</a>
    <form method="post" action="/sahipler/<%= owner.id %>/anonimlestir" data-confirm="Kişisel bilgiler kalıcı olarak silinecek; kayıt kimliği ve SMS sayıları kalacak. Emin misiniz?">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary" type="submit">Anonimleştir</button>
    </form>
    <form method="post" action="/sahipler/<%= owner.id %>/sil" data-confirm="Bu hasta sahibi, tüm hayvanları ve hatırlatmaları silinecek; SMS kayıtlarındaki kişisel bilgiler anonimleştirilecek. Emin misiniz?">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger" type="submit">Sil</button>
    </form>
    <% } %>
  </div>
</div>
<% if (anonymized) { %><div class="flash ok">Bu kayıt anonimleştirilmiş; kişisel bilgiler kalıcı olarak silinmiştir.</div><% } %>
<div class="card">
  <div class="row">
    <div><strong>Telefon:</strong> <% if (anonymized) { %>—<% } else { %><a class="mono" href="tel:<%= owner.phone %>"><%= formatPhone(owner.phone) %></a><% } %></div>
    <% if (owner.email) { %><div><strong>E-posta:</strong> <%= owner.email %></div><% } %>
    <% if (owner.address) { %><div><strong>Adres:</strong> <%= owner.address %></div><% } %>
    <div><strong>SMS:</strong> <% if (owner.sms_opt_in) { %><span class="badge ok">Açık</span><% } else { %><span class="badge cancelled">Kapalı</span><% } %></div>
    <% if (owner.import_batch) { %><div class="small muted">içe aktarıldı</div><% } %>
  </div>
  <% if (owner.notes) { %><p class="pre small"><%= owner.notes %></p><% } %>
  <% if (owner.sms_opt_in && !anonymized) { %>
  <form method="post" action="/sahipler/<%= owner.id %>/ret" class="row mt10" data-confirm="Hatırlatma SMS'leri durdurulacak ve ret kaydı tutulacak. Emin misiniz?">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <select name="channel" aria-label="Ret kanalı"><option value="telefon">Telefonla bildirdi</option><option value="sozlu">Yüz yüze bildirdi</option></select>
    <input type="text" name="note" maxlength="200" placeholder="not (isteğe bağlı)" class="maxw260">
    <button class="btn sm secondary" type="submit">SMS'leri durdur (ret)</button>
  </form>
  <div class="help">Ret talebi en geç 3 iş günü içinde uygulanmak zorundadır (Ticari İletişim Yön. m.10/1); burada anında uygulanır.</div>
  <% } %>
  <% if (consentList.length) { %>
    <details class="mt10"><summary class="small muted">SMS tercihi geçmişi (<%= consentList.length %>)</summary>
      <table class="small">
        <thead><tr><th>Zaman</th><th>İşlem</th><th>Kanal</th><th>Kaydeden</th><th>Not</th></tr></thead>
        <tbody><% for (const c of consentList) { %>
          <tr><td><%= formatDateTime(c.created_at) %></td><td><%= c.action === 'grant' ? 'Açıldı' : 'Ret' %></td><td><%= channels[c.channel] || c.channel %></td><td><%= c.actor_email || (c.channel === 'ret_url' ? 'hasta sahibi' : '') %></td><td><%= c.note || '' %></td></tr>
        <% } %></tbody>
      </table>
    </details>
  <% } %>
</div>

<div class="row between"><h2>Hayvanlar</h2><a class="btn sm" href="/sahipler/<%= owner.id %>/hayvan/yeni">+ Hayvan ekle</a></div>
<div class="card">
  <% if (!petList.length) { %><div class="empty">Henüz hayvan eklenmemiş.</div><% } else { %>
  <table class="cards">
    <thead><tr><th>Ad</th><th>Tür / Irk</th><th>Cinsiyet</th><th>Doğum</th><th><span class="visually-hidden">İşlemler</span></th></tr></thead>
    <tbody>
    <% for (const p of petList) { %>
    <tr>
      <td data-label="Ad"><strong><%= p.name %></strong></td>
      <td data-label="Tür / Irk"><%= p.species || '' %><%= p.breed ? ' / ' + p.breed : '' %></td>
      <td data-label="Cinsiyet"><%= p.sex || '' %></td>
      <td data-label="Doğum"><%= formatDate(p.birth_date) %><% if (p.microchip_no) { %><br><span class="small muted mono">çip <%= p.microchip_no %></span><% } %></td>
      <td class="actions">
        <a class="btn sm" href="/hayvanlar/<%= p.id %>/hatirlatma/yeni">+ Hatırlatma</a>
        <a class="btn sm secondary" href="/hayvanlar/<%= p.id %>/duzenle">Düzenle</a>
        <% if (user.role === 'admin') { %>
        <form method="post" action="/hayvanlar/<%= p.id %>/sil" data-confirm="Hayvan ve hatırlatmaları silinecek. Emin misiniz?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm danger" type="submit">Sil</button></form>
        <% } %>
      </td>
    </tr>
    <% } %>
    </tbody>
  </table>
  <% } %>
</div>

<h2>Hatırlatmalar</h2>
<div class="card">
  <% if (!reminderList.length) { %><div class="empty">Hatırlatma yok.</div><% } else { %>
  <table class="cards">
    <thead><tr><th>Tarih</th><th>Hayvan</th><th>Hatırlatma</th><th>Bildirim</th><th>Durum</th><th><span class="visually-hidden">İşlemler</span></th></tr></thead>
    <tbody>
    <% for (const r of reminderList) { %>
    <tr>
      <td data-label="Tarih"><%= formatDate(r.due_date) %></td>
      <td data-label="Hayvan"><%= r.pet_name %></td>
      <td data-label="Hatırlatma"><%= r.title %> <span class="small muted">(<%= REMINDER_TYPES[r.type] || r.type %>)</span><% if (r.repeat_days) { %><br><span class="small muted">her <%= r.repeat_days %> günde tekrar</span><% } %></td>
      <td class="small" data-label="Bildirim"><%= r.notify_days_before %> gün önce<% if (r.sent_at) { %><br><span class="muted">gönderildi: <%= formatDateTime(r.sent_at) %></span><% } %></td>
      <td data-label="Durum"><span class="badge <%= r.status %>"><%= STATUS_LABELS[r.status] %></span><% if (r.last_error) { %><br><span class="small muted"><%= r.last_error %></span><% } %></td>
      <td class="actions">
        <% if ((r.status === 'pending' || r.status === 'failed') && owner.sms_opt_in) { %>
          <form method="post" action="/hatirlatmalar/<%= r.id %>/gonder"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm" type="submit">SMS gönder</button></form>
        <% } %>
        <% if (r.status !== 'done' && r.status !== 'cancelled') { %>
          <form method="post" action="/hatirlatmalar/<%= r.id %>/durum"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="done"><button class="btn sm secondary" type="submit">Tamamlandı</button></form>
        <% } %>
        <a class="btn sm secondary" href="/hatirlatmalar/<%= r.id %>/duzenle">Düzenle</a>
      </td>
    </tr>
    <% } %>
    </tbody>
  </table>
  <% } %>
</div>

<h2>SMS geçmişi</h2>
<div class="card">
  <% if (!smsList.length) { %><div class="empty">Bu kişiye henüz SMS gönderilmedi.</div><% } else { %>
  <table class="cards">
    <thead><tr><th>Zaman</th><th>Mesaj</th><th>Durum</th></tr></thead>
    <tbody>
    <% for (const s of smsList) { %>
    <tr>
      <td class="small" data-label="Zaman"><%= formatDateTime(s.created_at) %></td>
      <td class="small pre" data-label="Mesaj"><%= s.message %></td>
      <td data-label="Durum"><span class="badge <%= s.status === 'sent' ? 'ok' : 'failed' %>"><%= s.status === 'sent' ? 'Gönderildi' : 'Hata' %></span><% if (s.error) { %><br><span class="small muted"><%= s.error %></span><% } %></td>
    </tr>
    <% } %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('partials/footer') %>
