<%- include('partials/header') %>
<%
  const chips = [
    ['/hatirlatmalar', 'Tümü', !filter.status && !filter.range],
    ['/hatirlatmalar?status=pending', 'Bekleyen', filter.status === 'pending'],
    ['/hatirlatmalar?range=today', 'Bugün', filter.range === 'today'],
    ['/hatirlatmalar?range=week', 'Bu hafta', filter.range === 'week'],
    ['/hatirlatmalar?range=month', 'Bu ay', filter.range === 'month'],
    ['/hatirlatmalar?status=sent', 'SMS gönderilen', filter.status === 'sent'],
    ['/hatirlatmalar?status=failed', 'Gönderilemeyen', filter.status === 'failed'],
    ['/hatirlatmalar?status=done', 'Tamamlanan', filter.status === 'done'],
  ];
%>
<div class="page-head">
  <div>
    <h1>Hatırlatmalar</h1>
    <p class="sub"><%= list.length %> kayıt · randevu tarihine göre sıralı</p>
  </div>
  <div class="page-actions">
    <a class="btn" href="/hizli-kayit"><%- icon('zap') %>Hızlı kayıt</a>
  </div>
</div>
<nav class="tabs" aria-label="Filtre">
  <% for (const [href, label, on] of chips) { %><a href="<%= href %>" class="<%= on ? 'active' : '' %>"<%- on ? ' aria-current="true"' : '' %>><%= label %></a><% } %>
</nav>
<div class="card flush">
  <% if (!list.length) { %>
    <div class="empty-state"><span class="es-icon"><%- icon('inbox') %></span><span class="es-title">Kayıt yok.</span><span class="es-text">Bu filtrede hatırlatma bulunmuyor. Yeni hatırlatma için hasta sahibi sayfasında hayvanın yanındaki "+ Hatırlatma" düğmesini ya da Hızlı kayıt'ı kullanın.</span></div>
  <% } else { %>
    <div class="card-head"><p class="sub">Yeni hatırlatma eklemek için hasta sahibi sayfasından ilgili hayvanın yanındaki "+ Hatırlatma" düğmesini kullanın.</p></div>
    <%- include('partials/reminder_list', { rows: list, actions: 'full' }) %>
  <% } %>
</div>
<%- include('partials/footer') %>
