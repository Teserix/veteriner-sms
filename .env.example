# Sunucu
PORT=3000
# Üretimde (HTTPS arkasında) "production" yapın; çerezler yalnızca HTTPS üzerinden gönderilir.
NODE_ENV=development
# Nginx/Caddy/Cloudflare Tunnel gibi bir ters vekil arkasındaysanız 1 yapın (gerçek IP için).
TRUST_PROXY=0

# En az 32 karakterlik rastgele bir gizli anahtar. SMS hesap bilgileri bununla şifrelenir.
# Üretmek için:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Bu yer tutucu değerle üretimde açılmaz.
APP_SECRET=degistirin-bu-degeri-en-az-32-karakter-olacak-sekilde

# Uygulamanın dışarıdan erişildiği adres(ler) (üretimde zorunlu). CSRF/Origin kontrolü için.
# Birden çok adres virgülle: https://vet.example.com,https://makine.tailnet.ts.net
APP_ORIGIN=http://localhost:3000

# Veri klasörü (master.db, tenants/, backups/, trash/ burada tutulur)
DATA_DIR=./data

# İlk açılışta hiç kullanıcı yoksa bu bilgilerle bir süper yönetici oluşturulur.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=GucluBirSifre123

# Otomatik hatırlatma gönderimi. Yalnızca TEK kopyada 1 yapın (çift gönderim riski).
ENABLE_SCHEDULER=1
# Zamanlayıcı kaç saniyede bir hatırlatmaları kontrol etsin
SCHEDULER_INTERVAL_SECONDS=60

# Gece yedeği: İstanbul saatiyle bu saatten sonra günde bir kez data/backups/ altına
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14

# --- Makine dışı şifreli yedek (Kişisel Veri Güvenliği Rehberi §3.6) ---
# İkinci hedef: ayrı disk / USB / ağ dışı bağlama noktası. Boşsa yalnızca data/backups yazılır.
BACKUP_SECONDARY_DIR=
# Yedek şifreleme anahtarı (>= 32 karakter, APP_SECRET'ten FARKLI). Yoksa ikinci hedefe kopya alınmaz.
# Üretmek için: openssl rand -base64 48
BACKUP_KEY=

# --- Hizmet sağlayıcı (Teserix) kimlik bilgileri: /iletisim sayfası ve hukuki metinler (5651 m.3; 6563 m.3) ---
COMPANY_NAME=
COMPANY_LEGAL_FORM=esnaf
COMPANY_TAX_ID=
COMPANY_MERSIS=
COMPANY_TRADE_REGISTRY_NO=
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_KEP=
COMPANY_HOSTING_PROVIDER=
